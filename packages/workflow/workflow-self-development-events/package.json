{
  "name": "@deepseek-ai/dsh-workflow-self-development-events",
  "description": "Opt-in self-development event projection: unified notification events folded from durable task commits, an in-memory recent-event buffer, subscriber callbacks, and an optional macOS local-notification command",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/workflow/workflow-self-development-events"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "workspace:^",
    "@deepseek-ai/dsh-workflow-self-development": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^",
    "@deepseek-ai/dsh-workflow-self-development": "workspace:^"
  }
}
